<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
{%- for p in projects %}
  <url><loc>{{ site.url }}/projects/{{ p.slug }}/</loc></url>
{%- endfor %}
{%- for p in pubDetail %}
  <url><loc>{{ site.url }}/publications/{{ p.slug }}/</loc></url>
{%- endfor %}
</urlset>
