---
layout: base.njk
---
{% set figs = pub.figures or [] %}
{% set leadFig = figs | figuresLead %}
{% set problemFigs = figs | figuresIn("problem") %}
{% set approachFigs = figs | figuresIn("approach") %}
{% set resultsFigs = figs | figuresIn("results") %}
{% set featuredFigs = figs | figuresFeatured %}
{% set gridFigs = figs | figuresGrid %}
{% set residualFigs = figs | figuresResidual %}

<article class="detail pub-detail">
  <header class="detail-head">
    <h1>{{ pub.title }}</h1>
    <p class="authors">{{ pub.authors | replace("Ju O Kim", "<strong>Ju O Kim</strong>") | safe }}</p>
    <p class="venue">{{ pub.venue }}{% if pub.year %}, {{ pub.year }}{% endif %}
      <span class="pub-badge pub-badge-{{ pub.badge }}">{{ pub.badge | upper }}</span></p>
    <p class="detail-actions">
      {% if pub.paper_url %}<a class="paper-pill" href="{{ pub.paper_url }}">Paper</a>{% endif %}
      <a class="paper-pill" href="/data/{{ pub.bib }}.bib">Download BibTeX</a>
    </p>
  </header>

  {% if pub.tldr %}<div class="tldr"><strong>TL;DR.</strong> {{ pub.tldr }}</div>{% endif %}

  {# ---- EVIDENCE STRIP (headline numbers, verbatim from results; live selectable text) ---- #}
  {% if pub.stats and pub.stats.length %}
  <div class="stat-strip">
  {% for s in pub.stats %}
    <div class="stat-card">
      <span class="stat-value">{{ s.value }}</span>
      <span class="stat-label">{{ s.label }}</span>
      {% if s.sub %}<span class="stat-sub">{{ s.sub }}</span>{% endif %}
    </div>
  {% endfor %}
  </div>
  {% endif %}

  {# ---- LEAD / HERO explainer (the new method-flow diagram, bleeds wide, eager) ---- #}
  {% if leadFig %}
  <figure class="proj-figure figure-hero">
    {% if leadFig.title %}<p class="fig-title">{{ leadFig.title }}</p>{% endif %}
    {% image leadFig.src, leadFig.alt, [768, 1280], "(max-width: 960px) 92vw, 920px", "", true %}
    {% if leadFig.caption %}<figcaption>{{ leadFig.caption }}</figcaption>{% endif %}
  </figure>
  {% endif %}

  {# ---- PROBLEM (+ its figure interleaved) ---- #}
  {% if pub.problem %}
  <section class="proj-section">
    <h2>Problem</h2>
    <p>{{ pub.problem }}</p>
    {% for f in problemFigs %}
    <figure class="proj-figure">
      {% if f.title %}<p class="fig-title">{{ f.title }}</p>{% endif %}
      {% image f.src, f.alt, [768, 1280], "(max-width: 760px) 100vw, 720px" %}
      {% if f.caption %}<figcaption>{{ f.caption }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
  </section>
  {% endif %}

  {# ---- APPROACH (+ method figures interleaved) ---- #}
  {% if pub.approach and pub.approach.length %}
  <section class="proj-section">
    <h2>Approach</h2>
    <ul class="bullets">{% for a in pub.approach %}<li>{{ a }}</li>{% endfor %}</ul>
    {% for f in approachFigs %}
    <figure class="proj-figure">
      {% if f.title %}<p class="fig-title">{{ f.title }}</p>{% endif %}
      {% image f.src, f.alt, [768, 1280], "(max-width: 760px) 100vw, 720px" %}
      {% if f.caption %}<figcaption>{{ f.caption }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
  </section>
  {% endif %}

  {# ---- KEY RESULTS (headline/dense figures full-width, the rest in a grid) ---- #}
  {% if pub.results and pub.results.length %}
  <section class="proj-section">
    <h2>Key results</h2>
    <ul class="bullets">{% for r in pub.results %}<li>{{ r }}</li>{% endfor %}</ul>
    {# featured: dense, headline evidence rendered at text-column/hero width so it stays legible #}
    {% for f in featuredFigs %}
    <figure class="proj-figure figure-feature">
      {% if f.title %}<p class="fig-title">{{ f.title }}</p>{% endif %}
      {% image f.src, f.alt, [768, 1280], "(max-width: 960px) 92vw, 920px" %}
      {% if f.caption %}<figcaption>{{ f.caption }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
    {# the remaining sparse, grid-survivable result figures #}
    {% if gridFigs.length %}
    <div class="results-grid">
    {% for f in gridFigs %}
      <figure class="proj-figure">
        {% if f.title %}<p class="fig-title">{{ f.title }}</p>{% endif %}
        {% image f.src, f.alt, [640, 1024], "(max-width: 768px) 92vw, 300px" %}
        {% if f.caption %}<figcaption>{{ f.caption }}</figcaption>{% endif %}
      </figure>
    {% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  {# ---- MORE FIGURES (any figure not bound to a section; never drops a figure) ---- #}
  {% if residualFigs.length %}
  <section class="proj-section">
    <h2>More figures</h2>
    <div class="gallery">
    {% for f in residualFigs %}
      <figure>
        {% if f.title %}<p class="fig-title">{{ f.title }}</p>{% endif %}
        {% image f.src, f.alt, [768, 1280], "(max-width: 760px) 100vw, 720px" %}
        {% if f.caption %}<figcaption>{{ f.caption }}</figcaption>{% endif %}
      </figure>
    {% endfor %}
    </div>
  </section>
  {% endif %}

  {# ---- ABSTRACT (kept visible — academic readers expect it) ---- #}
  {% if pub.abstract %}
  <section class="proj-section">
    <h2>Abstract</h2>
    <p>{{ pub.abstract }}</p>
  </section>
  {% endif %}

  {# ---- REFERENCE (collapsed: citation, BibTeX, acknowledgements) ---- #}
  <details class="pub-reference">
    <summary>Citation, BibTeX &amp; acknowledgements</summary>

    {% if pub.citation %}
    <section class="proj-section">
      <h3>Citation</h3>
      <p class="pub-citation">{{ pub.citation }}</p>
    </section>
    {% endif %}

    <section class="proj-section">
      <h3>BibTeX <button class="copy-btn" data-copy="#bibtex">Copy</button></h3>
      <textarea id="bibtex" class="bibtex" readonly rows="11">{{ pub.bib | bibtex }}</textarea>
    </section>

    {% if pub.acknowledgements %}
    <section class="proj-section">
      <h3>Acknowledgements</h3>
      <p>{{ pub.acknowledgements }}</p>
    </section>
    {% endif %}
  </details>

  <p class="detail-back"><a href="/#publications">&larr; All publications</a></p>
</article>
