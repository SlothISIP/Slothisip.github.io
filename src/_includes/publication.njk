---
layout: base.njk
---
<article class="detail pub-detail">
  <header class="detail-head">
    <h1>{{ pub.title }}</h1>
    <p class="authors">{{ pub.authors | replace("Ju O Kim", "<strong>Ju O Kim</strong>") | safe }}</p>
    <p class="venue">{{ pub.venue }}{% if pub.year %}, {{ pub.year }}{% endif %}
      <span class="pub-badge pub-badge-{{ pub.badge }}">{{ pub.badge | upper }}</span></p>
    <p class="detail-actions">
      {% if pub.paper_url %}<a class="paper-pill" href="{{ pub.paper_url }}">Paper</a>{% endif %}
      <a class="paper-pill" href="/data/{{ pub.bib }}.bib">BibTeX</a>
    </p>
  </header>

  {# Phase 5 adds: Abstract, figures, inline BibTeX, Acknowledgements #}

  <p class="detail-back"><a href="/#publications">&larr; All publications</a></p>
</article>
